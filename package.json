{
  "name": "gww-link-shortener",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:reset": "wrangler d1 execute DB --local --command \"DELETE FROM links; DELETE FROM rate_limit_events;\"",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@tanstack/react-query": "^5.108.0",
    "@trpc/client": "^11.29.4",
    "@trpc/react-query": "^11.29.4",
    "@trpc/server": "^11.29.4",
    "drizzle-orm": "^0.45.4",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.4",
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "typescript": "^5",
    "vitest": "^4.1.12",
    "wrangler": "^4.164.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
